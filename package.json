{
  "name": "azdo-extension-team-randomizer",
  "description": "Random Team Member selector for daily standups",
  "version": "0.0.0-development",
  "packageManager": "pnpm@11.10.0",
  "author": "Microsoft Corporation",
  "contributors": [
    "Dariusz Porowski",
    "Engin Polat"
  ],
  "dependencies": {
    "azure-devops-extension-api": "^5.274.0",
    "azure-devops-extension-sdk": "^5.0.0",
    "azure-devops-ui": "^2.276.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.3.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "es6-promise": "^4.2.8",
    "rimraf": "^6.1.3",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "syncpack": "^15.3.2",
    "tfx-cli": "^0.23.3",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  },
  "repository": "microsoft/azdo-extension-team-randomizer",
  "scripts": {
    "build:dev": "pnpm run compile:dev && dotenvx run --env-file dev.env -- node scripts/tfx.mjs create dev",
    "build:prod": "pnpm run compile:prod && dotenvx run --env-file prod.env -- node scripts/tfx.mjs create prod",
    "clean": "rimraf dist && rimraf -g *.vsix",
    "clean:modules": "node -e \"require('node:fs').rmSync('node_modules', { recursive: true, force: true })\"",
    "compile:dev": "pnpm run clean && webpack --mode development",
    "compile:prod": "pnpm run clean && webpack --mode production",
    "format": "syncpack format && pnpm dlx prettier --config ./.github/linters/.prettierrc.yml --write './**/*.{js,cjs,mjs,ts,tsx,jsx,htm,html,scss,css}'",
    "publish:dev": "pnpm run compile:dev && dotenvx run --env-file dev.env -- node scripts/tfx.mjs publish dev",
    "publish:prod": "pnpm run compile:prod && dotenvx run --env-file prod.env -- node scripts/tfx.mjs publish prod",
    "start:dev": "webpack-dev-server --mode development --progress --open",
    "start:prod": "webpack-dev-server --mode production --progress --open"
  },
  "type": "module"
}
